{
  "$schema": "../node_modules/@tauri-apps/cli/schema/capabilities.json",
  "identifier": "default",
  "description": "Default capabilities for VtM Campaign Manager",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "dialog:allow-open",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "fs:allow-appconfig-read-recursive",
    "fs:allow-appconfig-write-recursive",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://overpass-api.de/*" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$TEMP/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$TEMP/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$TEMP/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$TEMP/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" }
      ]
    }
  ]
}
