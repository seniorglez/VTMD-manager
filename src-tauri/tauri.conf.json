{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VtM Campaign Manager",
  "version": "../package.json",
  "identifier": "com.vtm.campaign-manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "VtM Campaign Manager",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "deb": {
      "longDescription": "Campaign manager for Vampire: The Masquerade. Create and edit VTMD documents for characters, NPCs, chapters and campaign modules.",
      "section": "utility"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREMEI2M0ZFNDBBM0YzMkMKUldRczg2TkEvbU1MVGJTTS94QW01a3ZyTFNabHJBS3lLeFg5L01hWGU0K2NyRkVvZ0c5VS9hbmgK",
      "endpoints": [
        "https://github.com/seniorglez/VTMD-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
